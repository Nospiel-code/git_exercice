Utiliser les constantes de Constantes
Algo HelloWorld {
  fonction principale {
    // Creation de la fenetre
    Creer une fenetre de titre HELLO_WORLD_TITLE
    Mettre la dimension a 600, 300
    Configurer la fenetre sur 'exitOnClose'
    // Creation du label de texte
    Creer un label avec du texte aligne a gauche et contenant le texte HELLO_WORLD_TEXT
    Creer la couleur bleue
    Mettre la couleur bleue sur le label
    // Couleur de fond
    Creer la couleur verte
    Mettre la couleur verte en fond d'ecran
    // Finalisation
    Ajouter le label sur la fenetre
    Afficher la fenetre
  }
}
